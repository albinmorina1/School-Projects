<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestCoastEducation.Desktop.ViewModels"
        x:Class="WestCoastEducation.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WestCoast Education - Administration"
        Width="1050" Height="740">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="15">
            <TextBlock Text="WestCoast Education Admin"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource HeaderTextBrush}"/>
        </Border>

        <!-- Huvudinnehåll -->
        <TabControl Grid.Row="1" Margin="10">

            <!-- Flik 1: Kurser -->
            <TabItem Header="Kurser">
                <Grid RowDefinitions="*, Auto, Auto, Auto" Margin="10">
                    <DataGrid ItemsSource="{Binding Kurser}"
                              SelectedItem="{Binding ValdKurs}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              Grid.Row="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kursnummer" Binding="{Binding Kursnummer}"/>
                            <DataGridTextColumn Header="Titel" Binding="{Binding Title}"/>
                            <DataGridTextColumn Header="Längd (Dagar)" Binding="{Binding LangdDagar}"/>
                            <DataGridTextColumn Header="StartDatum" Binding="{Binding StartDatum, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                            <DataGridTextColumn Header="SlutDatum" Binding="{Binding SlutDatum, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Spacing="10" Margin="0,10,0,10">
                        <Button Content="Uppdatera lista"
                                Command="{Binding LaddaDataAsync}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="{DynamicResource HeaderTextBrush}"/>
                        <Button Content="Ta bort markerad kurs"
                                Command="{Binding TaBortKursAsync}"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource HeaderTextBrush}"/>
                    </StackPanel>

                    <!-- Formulär för att LÄGGA TILL kurs -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,8">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Lägg till ny kurs:" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox Text="{Binding NyKursNummer, Mode=TwoWay}" Watermark="Kursnummer (t.ex. CS101)" Width="180"/>
                                <TextBox Text="{Binding NyKursTitel, Mode=TwoWay}" Watermark="Kurstitel" Width="280"/>
                                <TextBox Text="{Binding NyKursLangd, Mode=TwoWay}" Watermark="Längd i dagar" Width="120"/>
                                <Button Content="Lägg till kurs"
                                        Command="{Binding LaggTillKursAsync}"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulär för att UPPDATERA kurs -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Redigera markerad kurs:" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox Text="{Binding ValdKurs.Title, Mode=TwoWay}" Watermark="Titel" Width="280"/>
                                <TextBox Text="{Binding ValdKurs.Kursnummer, Mode=TwoWay}" Watermark="Kursnummer" Width="180"/>
                                <Button Content="Spara ändringar"
                                        Command="{Binding UppdateraKursAsync}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Flik 2: Studerande -->
            <TabItem Header="Studerande">
                <Grid RowDefinitions="*, Auto, Auto, Auto" Margin="10">
                    <DataGrid ItemsSource="{Binding StuderandeLista}"
                              SelectedItem="{Binding ValdStuderande}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              Grid.Row="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Förnamn" Binding="{Binding Fornamn}"/>
                            <DataGridTextColumn Header="Efternamn" Binding="{Binding Efternamn}"/>
                            <DataGridTextColumn Header="Personnummer" Binding="{Binding Personnummer}"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}"/>
                            <DataGridTextColumn Header="E-post" Binding="{Binding Epost}"/>
                            <DataGridTextColumn Header="Ort" Binding="{Binding Ort}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Spacing="10" Margin="0,10,0,10">
                        <Button Content="Uppdatera lista"
                                Command="{Binding LaddaDataAsync}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="{DynamicResource HeaderTextBrush}"/>
                    </StackPanel>

                    <!-- Formulär för att LÄGGA TILL student -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Lägg till ny student:" FontWeight="Bold"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NyStudentFornamn, Mode=TwoWay}" Watermark="Förnamn" Width="140" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentEfternamn, Mode=TwoWay}" Watermark="Efternamn" Width="140" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentPersonnummer, Mode=TwoWay}" Watermark="Personnummer" Width="150" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentTelefon, Mode=TwoWay}" Watermark="Telefon" Width="130" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentEpost, Mode=TwoWay}" Watermark="E-post" Width="190" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentAdress, Mode=TwoWay}" Watermark="Gatuadress" Width="160" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentPostnummer, Mode=TwoWay}" Watermark="Postnummer" Width="110" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyStudentOrt, Mode=TwoWay}" Watermark="Ort" Width="130" Margin="0,0,8,6"/>
                                <Button Content="Lägg till student"
                                        Command="{Binding LaggTillStuderandeAsync}"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"
                                        Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulär för att UPPDATERA student -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Redigera markerad student:" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox Text="{Binding ValdStuderande.Fornamn, Mode=TwoWay}" Watermark="Förnamn" Width="150"/>
                                <TextBox Text="{Binding ValdStuderande.Efternamn, Mode=TwoWay}" Watermark="Efternamn" Width="150"/>
                                <TextBox Text="{Binding ValdStuderande.Epost, Mode=TwoWay}" Watermark="E-post" Width="220"/>
                                <TextBox Text="{Binding ValdStuderande.Personnummer, Mode=TwoWay}" Watermark="Personnummer" Width="160"/>
                                <Button Content="Spara student"
                                        Command="{Binding UppdateraStuderandeAsync}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Flik 3: Lärare -->
            <TabItem Header="Lärare">
                <Grid RowDefinitions="*, Auto, Auto, Auto" Margin="10">
                    <!-- Övre del: Tabell + Kompetensområden sida vid sida -->
                    <Grid Grid.Row="0" ColumnDefinitions="2*, *">
                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding LarareLista}"
                                  SelectedItem="{Binding ValdLarare}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  Margin="0,0,10,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Förnamn" Binding="{Binding Fornamn}"/>
                                <DataGridTextColumn Header="Efternamn" Binding="{Binding Efternamn}"/>
                                <DataGridTextColumn Header="Personnummer" Binding="{Binding Personnummer}"/>
                                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}"/>
                                <DataGridTextColumn Header="E-post" Binding="{Binding Epost}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Panel för att hantera markerad lärares kompetensområde -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5">
                            <Grid RowDefinitions="Auto, *, Auto, Auto">
                                <TextBlock Grid.Row="0" Text="Kompetensområden (vald lärare):" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ValdLarareKompetenser}"
                                         SelectedItem="{Binding ValdKompetens}"
                                         Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                    <TextBox Text="{Binding NyttKompetensomrade, Mode=TwoWay}" Watermark="T.ex. C#, Databaser" Width="170"/>
                                    <Button Content="Lägg till"
                                            Command="{Binding LaggTillKompetensAsync}"
                                            Background="{DynamicResource SuccessBrush}"
                                            Foreground="{DynamicResource HeaderTextBrush}"/>
                                </StackPanel>
                                <Button Grid.Row="3"
                                        Content="Ta bort valt kompetensområde"
                                        Command="{Binding TaBortKompetensAsync}"
                                        Background="{DynamicResource DangerBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Spacing="10" Margin="0,10,0,10">
                        <Button Content="Uppdatera lista"
                                Command="{Binding LaddaDataAsync}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="{DynamicResource HeaderTextBrush}"/>
                    </StackPanel>

                    <!-- Formulär för att LÄGGA TILL lärare -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Lägg till ny lärare:" FontWeight="Bold"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NyLarareFornamn, Mode=TwoWay}" Watermark="Förnamn" Width="150" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyLarareEfternamn, Mode=TwoWay}" Watermark="Efternamn" Width="150" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyLararePersonnummer, Mode=TwoWay}" Watermark="Personnummer" Width="160" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyLarareTelefon, Mode=TwoWay}" Watermark="Telefon" Width="140" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding NyLarareEpost, Mode=TwoWay}" Watermark="E-post" Width="210" Margin="0,0,8,6"/>
                                <Button Content="Lägg till lärare"
                                        Command="{Binding LaggTillLarareAsync}"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"
                                        Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulär för att UPPDATERA lärare -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="5">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Redigera markerad lärare:" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox Text="{Binding ValdLarare.Fornamn, Mode=TwoWay}" Watermark="Förnamn" Width="150"/>
                                <TextBox Text="{Binding ValdLarare.Efternamn, Mode=TwoWay}" Watermark="Efternamn" Width="150"/>
                                <TextBox Text="{Binding ValdLarare.Epost, Mode=TwoWay}" Watermark="E-post" Width="220"/>
                                <TextBox Text="{Binding ValdLarare.Personnummer, Mode=TwoWay}" Watermark="Personnummer" Width="160"/>
                                <Button Content="Spara lärare"
                                        Command="{Binding UppdateraLarareAsync}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Foreground="{DynamicResource HeaderTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>